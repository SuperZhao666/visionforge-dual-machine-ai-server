#pragma once

#include <array>
#include <string_view>

#include "vfdual/host_usage_ticket_keyring_build.hpp"

namespace vfdual::build {

// Public-only pair-generation credential PEM files, each outer-encoded as
// canonical standard Base64. The generated header remains private to the Host
// verifier target. Usage-ticket keys are exposed separately so the verifier
// can reject cross-purpose RSA-key reuse before accepting any credential.
inline constexpr std::array<std::string_view, @VFDUAL_PAIR_CREDENTIAL_KEY_COUNT@>
    kPairGenerationCredentialPublicPemBase64{
@VFDUAL_PAIR_CREDENTIAL_KEY_ENTRIES@};

inline constexpr auto& kPairGenerationOtherPurposeUsageTicketPublicPemBase64 =
    kUsageTicketPublicPemBase64;

}  // namespace vfdual::build
