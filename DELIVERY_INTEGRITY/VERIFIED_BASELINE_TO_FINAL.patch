+  [[nodiscard]] std::optional<std::uint64_t> candidate_epoch() const noexcept;
+  [[nodiscard]] bool is_retired(std::uint64_t stream_epoch) const noexcept;
+  [[nodiscard]] std::size_t retired_count() const noexcept;
