# Copy to /etc/visionforge-dual-machine/service.env and chmod 0600.
# Never reuse the single-machine database, SECRET_KEY, payment keys, or lease key.
DUAL_MACHINE_BIND_HOST=127.0.0.1
DUAL_MACHINE_BIND_PORT=8010
DUAL_MACHINE_DATABASE_PATH=/var/lib/visionforge-dual-machine/vf_dual_machine.db

# Generate independent random values of at least 32 bytes for both variables.
DUAL_MACHINE_LICENSE_CODE_SECRET=replace-with-independent-random-secret
DUAL_MACHINE_TOKEN_SECRET=replace-with-another-independent-random-secret
# Shared only with the authenticated web-admin process. Never reuse either
# secret above, the platform SECRET_KEY, or any payment/integration secret.
DUAL_MACHINE_ADMIN_BRIDGE_SECRET=replace-with-third-independent-random-secret
DUAL_MACHINE_ADMIN_BRIDGE_MAX_SKEW_SECONDS=30

DUAL_MACHINE_LICENSE_CODE_KEY_VERSION=1
DUAL_MACHINE_LICENSE_CODE_PREVIOUS_KEYS_JSON={}
DUAL_MACHINE_MIN_HOST_CLIENT_VERSION=1.0.0
DUAL_MACHINE_MIN_ANDROID_CLIENT_VERSION=1.0.0
DUAL_MACHINE_TICKET_PRIVATE_KEY_PATH=/etc/visionforge-dual-machine/usage-ticket-private.pem
DUAL_MACHINE_TICKET_PUBLIC_KEY_PATH=/etc/visionforge-dual-machine/usage-ticket-public.pem
# During a controlled rotation, list up to three old public keys here. They
# verify in-flight tickets only; all new tickets use the current private key.
DUAL_MACHINE_TICKET_PREVIOUS_PUBLIC_KEYS_JSON=[]
DUAL_MACHINE_TICKET_PRIVATE_KEY_PASSWORD=

# Pair-generation credentials use a separate RSA-3072 signing identity. Never
# reuse the usage-ticket key above, even through a different file path.
DUAL_MACHINE_PAIR_CREDENTIAL_PRIVATE_KEY_PATH=/etc/visionforge-dual-machine/pair-credential-private.pem
DUAL_MACHINE_PAIR_CREDENTIAL_PUBLIC_KEY_PATH=/etc/visionforge-dual-machine/pair-credential-public.pem
# At most two previous online keys may verify credentials during rotation.
# Verification-only archive keys preserve exact immutable journal replay after
# the online rotation window; at most thirteen archive keys are accepted.
DUAL_MACHINE_PAIR_CREDENTIAL_PREVIOUS_PUBLIC_KEYS_JSON=[]
DUAL_MACHINE_PAIR_CREDENTIAL_ARCHIVED_PUBLIC_KEYS_JSON=[]
DUAL_MACHINE_PAIR_CREDENTIAL_PRIVATE_KEY_PASSWORD=
DUAL_MACHINE_PAIR_CREDENTIAL_TTL_SECONDS=15

# Security and user-rights contract: five-second prepaid formal-use segments.
DUAL_MACHINE_USAGE_LEASE_TTL_SECONDS=5
DUAL_MACHINE_USAGE_RENEWAL_WINDOW_SECONDS=2
