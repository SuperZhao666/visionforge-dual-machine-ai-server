[Unit]
Description=VisionForge Platform
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vf-platform
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/ubuntu/vf-platform/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
