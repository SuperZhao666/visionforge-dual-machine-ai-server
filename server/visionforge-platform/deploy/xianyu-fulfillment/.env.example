# Replace with the immutable local_image_id printed by ./prepare.sh. Never use latest.
XIANYU_IMAGE=sha256:replace-with-local-image-id-from-prepare
XIANYU_ADMIN_PORT=6202

# Stable private account label used only to derive an opaque order idempotency token.
XIANYU_PROVIDER_ACCOUNT=replace-with-stable-account-id

# Xianyu's own loopback-only administration login.
XIANYU_ADMIN_USERNAME=admin
XIANYU_ADMIN_PASSWORD=replace-with-random-password
XIANYU_JWT_SECRET=replace-with-at-least-32-random-characters

# Managed five-package workflow. Keep shadow until commercial authorization and
# a self-owned small-order acceptance test are both complete. Only live permits
# real API publishing or rule activation; off disables managed mutations.
VISIONFORGE_MANAGED_FULFILLMENT_MODE=shadow
# The upstream generic delivery switch is permanently fail-closed. Managed
# delivery is enabled only through the five-package workflow after readiness.
XIANYU_AUTO_DELIVERY_ENABLED=false
VISIONFORGE_PACKAGE_SPEC_NAME=套餐
VISIONFORGE_PACKAGE_SPEC_VALUES=1小时,5小时,10小时,50小时,100小时
VISIONFORGE_PACKAGE_PRODUCT_KEYS='{"1小时":"1h","5小时":"5h","10小时":"10h","50小时":"50h","100小时":"100h"}'
VISIONFORGE_PACKAGE_DEFAULT_INVENTORY=999
VISIONFORGE_MANAGED_BRIDGE_URL=http://fulfillment-bridge:8080/issue

# Static token is used only from xianyu-app to the private bridge network.
BRIDGE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

# Bridge to Platform: HMAC service identity, timestamp and one-time nonce.
PLATFORM_HOSTNAME=www.visionforge.cloud
PLATFORM_CODE_ISSUANCE_URL=https://www.visionforge.cloud/api/integrations/code-issuances/issue
CODE_ISSUANCE_SERVICE_ID=xianyu-code-bridge
CODE_ISSUANCE_HMAC_SECRET=replace-with-at-least-32-random-characters

# Optional. Keep all three markers; literal \n is converted to a newline.
DELIVERY_MESSAGE_TEMPLATE=【VisionForge 自动发货】\n商品：{product_name}\n兑换码：{code}\n下载：{download_url}\n使用：安装客户端后登录，在账户中心兑换时长。
