+def _visionforge_error_parts(exc: Exception):
+    detail = exc.detail if isinstance(exc, HTTPException) else str(exc)
+    if isinstance(detail, dict):
+        candidate_code = str(detail.get('code') or '').strip()
+    else:
+        text = str(detail or '')
+        candidate_code = text.split(':', 1)[0].strip() if ':' in text else ''
+    if not re.fullmatch(r"[A-Z][A-Z0-9_]{2,80}", candidate_code):
+        candidate_code = "VISIONFORGE_OPERATION_FAILED"
+    is_safe_code = (
+        candidate_code in VISIONFORGE_PUBLIC_ERROR_MESSAGES
+        or candidate_code.startswith(VISIONFORGE_SAFE_ERROR_PREFIXES)
+    )
+    public_code = candidate_code if is_safe_code else "VISIONFORGE_OPERATION_FAILED"
+    public_message = VISIONFORGE_PUBLIC_ERROR_MESSAGES.get(
+        public_code,
+        "请求未通过校验，请根据错误码处理。"
+        if is_safe_code else "操作失败，请使用追踪编号联系管理员。",
+    )
+    return public_code, public_message
+
+
+def _visionforge_error_status(exc: Exception, error_code: str,
+                              requested_status: Optional[int]) -> int:
+    if error_code in VISIONFORGE_CONFLICT_ERROR_CODES:
+        return 409
+    if error_code == "OPERATION_NOT_FOUND":
+        return 404
+    if requested_status is not None:
+        return requested_status
+    if isinstance(exc, HTTPException) and 400 <= exc.status_code < 600:
+        return exc.status_code
+    return 400 if error_code != "VISIONFORGE_OPERATION_FAILED" else 500
+
+
+def _raise_visionforge_error(request: Request, exc: Exception,
+                             status_code: Optional[int] = None):
+    error_code, public_message = _visionforge_error_parts(exc)
+    trace_id = _visionforge_trace_id(request)
+    resolved_status = _visionforge_error_status(exc, error_code, status_code)
+    if resolved_status >= 500 or error_code == "VISIONFORGE_OPERATION_FAILED":
+        safe_stack = mask_sensitive_text(traceback.format_exc())[:8000]
+        logger.error(
+            f"VisionForge履约系统异常: code={error_code} trace_id={trace_id} "
+            f"stack={safe_stack}"
+        )
+    else:
+        logger.warning(f"VisionForge履约操作失败: code={error_code} trace_id={trace_id}")
+    raise HTTPException(
+        status_code=resolved_status,
+        detail={"code": error_code, "message": public_message, "trace_id": trace_id},
+    ) from exc
+
