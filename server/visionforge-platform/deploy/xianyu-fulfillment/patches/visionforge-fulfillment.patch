+++ b/infrastructure/visionforge_fulfillment_config.py
@@ -0,0 +1,103 @@
+"""Environment-backed configuration adapter for managed fulfillment."""
+
+import json
+import os
+from typing import Dict, Mapping, Optional
+
+from domain.visionforge_catalog import CatalogConfig, FulfillmentMode, parse_fulfillment_mode
+from infrastructure.visionforge_card_contract import ManagedApiCardContractValidator
+
+
+MANAGED_FULFILLMENT_MODE_ENV = "VISIONFORGE_MANAGED_FULFILLMENT_MODE"
+DEFAULT_MANAGED_FULFILLMENT_MODE = FulfillmentMode.SHADOW.value
+PACKAGE_SPEC_NAME_ENV = "VISIONFORGE_PACKAGE_SPEC_NAME"
+PACKAGE_SPEC_VALUES_ENV = "VISIONFORGE_PACKAGE_SPEC_VALUES"
+PACKAGE_DEFAULT_INVENTORY_ENV = "VISIONFORGE_PACKAGE_DEFAULT_INVENTORY"
+MANAGED_BRIDGE_URL_ENV = "VISIONFORGE_MANAGED_BRIDGE_URL"
+PACKAGE_PRODUCT_KEYS_ENV = "VISIONFORGE_PACKAGE_PRODUCT_KEYS"
+BRIDGE_INTERNAL_TOKEN_ENV = "BRIDGE_INTERNAL_TOKEN"
+GENERIC_AUTO_DELIVERY_ENABLED_ENV = "AUTO_DELIVERY_ENABLED"
+DEFAULT_MANAGED_BRIDGE_URL = "http://fulfillment-bridge:8080/issue"
+
+
+def load_managed_fulfillment_mode(
+    environment: Optional[Mapping[str, str]] = None,
+) -> FulfillmentMode:
+    source = environment if environment is not None else os.environ
+    return parse_fulfillment_mode(
+        source.get(MANAGED_FULFILLMENT_MODE_ENV, DEFAULT_MANAGED_FULFILLMENT_MODE)
+    )
+
+
+def is_generic_auto_delivery_enabled(
+    environment: Optional[Mapping[str, str]] = None,
+) -> bool:
+    """Fail closed unless the legacy delivery gate is explicitly ``true``."""
+    source = environment if environment is not None else os.environ
+    raw_value = source.get(GENERIC_AUTO_DELIVERY_ENABLED_ENV, "")
+    return isinstance(raw_value, str) and raw_value.strip().lower() == "true"
+
+
+def load_catalog_config(
+    environment: Optional[Mapping[str, str]] = None,
+) -> CatalogConfig:
+    source = environment if environment is not None else os.environ
+    spec_name = str(source.get(PACKAGE_SPEC_NAME_ENV, "套餐") or '').strip()
+    raw_values = source.get(
+        PACKAGE_SPEC_VALUES_ENV,
+        "1小时,5小时,10小时,50小时,100小时",
+    )
+    spec_values = tuple(
+        value.strip() for value in str(raw_values or '').split(',') if value.strip()
+    )
+    try:
+        default_inventory = int(source.get(PACKAGE_DEFAULT_INVENTORY_ENV, "999"))
+    except (TypeError, ValueError) as exc:
+        raise ValueError("CATALOG_CONFIG_INVALID: 默认库存必须是整数") from exc
+    return CatalogConfig(
+        spec_name=spec_name,
+        spec_values=spec_values,
+        default_inventory=default_inventory,
+        mode=load_managed_fulfillment_mode(source),
+    )
+
+
+def load_managed_card_validator(
+    config: CatalogConfig,
+    environment: Optional[Mapping[str, str]] = None,
+) -> ManagedApiCardContractValidator:
+    """Build the strict validator at the application composition root."""
+    source = environment if environment is not None else os.environ
+    return ManagedApiCardContractValidator(
+        bridge_url=source.get(MANAGED_BRIDGE_URL_ENV, DEFAULT_MANAGED_BRIDGE_URL),
+        product_keys_by_spec=_load_product_key_mapping(config, source),
+        bearer_token=source.get(BRIDGE_INTERNAL_TOKEN_ENV, ""),
+    )
+
+
+def _load_product_key_mapping(
+    config: CatalogConfig,
+    source: Mapping[str, str],
+) -> Dict[str, str]:
+    raw_mapping = str(source.get(PACKAGE_PRODUCT_KEYS_ENV, "") or "").strip()
+    if not raw_mapping:
+        raw_mapping = "1h,5h,10h,50h,100h"
+
+    if raw_mapping.startswith("{"):
+        try:
+            parsed = json.loads(raw_mapping)
+        except json.JSONDecodeError as exc:
+            raise ValueError("MANAGED_CARD_CONFIG_INVALID: 套餐取码映射不是有效 JSON") from exc
+        if not isinstance(parsed, dict):
+            raise ValueError("MANAGED_CARD_CONFIG_INVALID: 套餐取码映射必须是 JSON 对象")
+        mapping = {str(key).strip(): str(value).strip() for key, value in parsed.items()}
+    else:
+        product_keys = [value.strip() for value in raw_mapping.split(",") if value.strip()]
+        if len(product_keys) != len(config.spec_values):
+            raise ValueError("MANAGED_CARD_CONFIG_INVALID: 套餐取码映射数量不完整")
+        mapping = dict(zip(config.spec_values, product_keys))
+
+    configured_specs = {str(value).strip() for value in config.spec_values}
+    if set(mapping) != configured_specs:
+        raise ValueError("MANAGED_CARD_CONFIG_INVALID: 套餐取码映射与规格配置不一致")
+    return mapping
