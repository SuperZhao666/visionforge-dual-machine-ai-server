+"""Concrete upstream capability adapter for the VisionForge application service."""
+
+from typing import Any, Dict
+
+from utils.item_publisher import ItemPublisher
+
+
+class ItemPublisherCapabilitiesGateway:
+    def __init__(self, repository):
+        self.repository = repository
+
+    async def get_capabilities(self, user_id: int, account_id: str) -> Dict[str, Any]:
+        cookies = self.repository.get_all_cookies(user_id)
+        cookie_value = str(cookies.get(account_id) or '').strip()
+        if not cookie_value:
+            raise ValueError("ACCOUNT_COOKIE_MISSING: 账号 Cookie 为空")
+        proxy_config = self.repository.get_cookie_proxy_config(account_id)
+        async with ItemPublisher(
+            cookie_value,
+            account_id,
+            proxy_config=proxy_config,
+        ) as publisher:
+            return await publisher.get_publish_capabilities()
