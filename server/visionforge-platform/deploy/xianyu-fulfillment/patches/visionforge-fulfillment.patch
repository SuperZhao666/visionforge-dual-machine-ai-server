+"""Pure redaction rules for VisionForge fulfillment secrets."""
+
+from __future__ import annotations
+
+import copy
+import re
+from typing import Any, Dict
+
+
+REDACTED_REDEMPTION_CODE = "[REDACTED_REDEMPTION_CODE]"
+_FORMATTED_CODE_PATTERN = re.compile(
+    r"(?<![A-Z0-9])VF1-(?:[A-Z0-9]{4}-){5}[A-Z0-9]{4}-[A-Z0-9]{2}(?![A-Z0-9])",
+    re.IGNORECASE,
+)
+_NORMALIZED_CODE_PATTERN = re.compile(
+    r"(?<![A-Z0-9])VF1[A-Z0-9]{26}(?![A-Z0-9])",
+    re.IGNORECASE,
+)
+_MANAGED_SECRET_META_FIELDS = {
+    "body",
+    "card_description",
+    "content",
+    "data_line",
+    "delivery_content",
+    "delivery_steps",
+    "message",
+    "raw_response",
+    "reply",
+    "response",
+    "send_message",
+    "text",
+}
+
+
+def mask_sensitive_fulfillment_text(value: Any) -> str:
+    """Replace a complete redemption code without retaining recoverable fragments."""
+    masked = _FORMATTED_CODE_PATTERN.sub(REDACTED_REDEMPTION_CODE, str(value or ""))
+    return _NORMALIZED_CODE_PATTERN.sub(REDACTED_REDEMPTION_CODE, masked)
+
+
+def sanitize_delivery_meta(delivery_meta: Dict[str, Any] | None) -> Dict[str, Any]:
+    """Strip sent text only for managed exact delivery; generic metadata is unchanged."""
+    if not isinstance(delivery_meta, dict):
+        return {}
+    if delivery_meta.get("match_mode") != "managed_exact_binding":
+        return delivery_meta
+    return _sanitize_managed_value(copy.deepcopy(delivery_meta))
+
+
+def _sanitize_managed_value(value: Any) -> Any:
+    if isinstance(value, dict):
+        return {
+            key: _sanitize_managed_value(item)
+            for key, item in value.items()
+            if str(key).strip().lower() not in _MANAGED_SECRET_META_FIELDS
+        }
+    if isinstance(value, list):
+        return [_sanitize_managed_value(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(_sanitize_managed_value(item) for item in value)
+    if isinstance(value, str):
+        return mask_sensitive_fulfillment_text(value)
+    return value
