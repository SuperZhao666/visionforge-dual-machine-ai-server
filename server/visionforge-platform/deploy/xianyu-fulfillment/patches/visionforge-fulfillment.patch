@@ -0,0 +1,259 @@
+"""Strict private-bridge contract for VisionForge managed API cards."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import hmac
+import ipaddress
+import json
+import re
+from typing import Any, Dict, Mapping
+from urllib.parse import urlsplit, urlunsplit
+
+from domain.visionforge_catalog import normalize_spec_text
+
+
+MANAGED_CARD_CONFIG_INVALID = (
+    "MANAGED_CARD_CONFIG_INVALID: API 卡配置不符合托管即时发码契约"
+)
+MANAGED_CARD_CONFIG_DRIFTED = (
+    "MANAGED_CARD_CONFIG_DRIFTED: API 卡配置与服务端即时发码契约不一致"
+)
+
+_PRODUCT_KEY_PATTERN = re.compile(r"[a-z0-9][a-z0-9_-]{0,31}")
+_PLACEHOLDER_MARKERS = (
+    "replace-with",
+    "replace_with",
+    "placeholder",
+    "change-me",
+    "changeme",
+)
+
+
+def _coerce_api_config(api_config: Any) -> Dict[str, Any]:
+    if isinstance(api_config, str):
+        try:
+            api_config = json.loads(api_config)
+        except (TypeError, json.JSONDecodeError) as exc:
+            raise ValueError(MANAGED_CARD_CONFIG_INVALID) from exc
+    if not isinstance(api_config, dict):
+        raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+    return copy.deepcopy(api_config)
+
+
+def _normalize_private_bridge_url(value: Any) -> str:
+    raw_url = str(value or "").strip()
+    try:
+        parsed = urlsplit(raw_url)
+        port = parsed.port
+    except ValueError as exc:
+        raise ValueError(MANAGED_CARD_CONFIG_INVALID) from exc
+    if (
+        parsed.scheme.lower() not in {"http", "https"}
+        or not parsed.hostname
+        or parsed.username
+        or parsed.password
+        or parsed.query
+        or parsed.fragment
+    ):
+        raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+
+    hostname = parsed.hostname.lower().rstrip(".")
+    if hostname in {"0.0.0.0", "::"} or not _is_private_service_host(hostname):
+        raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+    normalized_path = parsed.path.rstrip("/") or "/"
+    netloc = f"[{hostname}]" if ":" in hostname else hostname
+    if port is not None:
+        netloc = f"{netloc}:{port}"
+    return urlunsplit((parsed.scheme.lower(), netloc, normalized_path, "", ""))
+
+
+def _is_private_service_host(hostname: str) -> bool:
+    if hostname == "localhost" or hostname.endswith((".internal", ".local")):
+        return True
+    try:
+        address = ipaddress.ip_address(hostname)
+    except ValueError:
+        # A single-label DNS name is a Docker/private-network service identity.
+        return "." not in hostname and bool(re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", hostname))
+    return address.is_private or address.is_loopback
+
+
+def _authorization_value(headers: Any) -> str:
+    if not isinstance(headers, dict):
+        raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+    matching_values = [
+        value for key, value in headers.items()
+        if str(key).strip().lower() == "authorization"
+    ]
+    if len(matching_values) != 1:
+        raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+    return str(matching_values[0] or "").strip()
+
+
+def fingerprint_managed_api_config(api_config: Any) -> str:
+    """Return a stable hash without retaining the Authorization credential."""
+    normalized = _coerce_api_config(api_config)
+    headers = normalized.get("headers")
+    if isinstance(headers, dict):
+        redacted_headers = {}
+        for key, value in headers.items():
+            if str(key).strip().lower() == "authorization":
+                redacted_headers[str(key)] = {
+                    "sha256": hashlib.sha256(
+                        str(value or "").strip().encode("utf-8")
+                    ).hexdigest()
+                }
+            else:
+                redacted_headers[str(key)] = value
+        normalized["headers"] = redacted_headers
+    canonical = json.dumps(
+        normalized,
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+        default=str,
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+def sanitize_api_card_for_response(card: Dict[str, Any]) -> Dict[str, Any]:
+    """Return a deep-copied card DTO with Authorization write-only."""
+    safe_card = copy.deepcopy(card)
+    if safe_card.get("type") != "api":
+        return safe_card
+    try:
+        api_config = _coerce_api_config(safe_card.get("api_config"))
+    except ValueError:
+        safe_card["api_config"] = None
+        safe_card["authorization_configured"] = False
+        return safe_card
+
+    headers = api_config.get("headers")
+    authorization_configured = False
+    if isinstance(headers, str):
+        try:
+            parsed_headers = json.loads(headers)
+        except json.JSONDecodeError:
+            parsed_headers = None
+        if isinstance(parsed_headers, dict):
+            headers = parsed_headers
+        else:
+            authorization_configured = bool(headers.strip())
+            headers = {}
+    if isinstance(headers, dict):
+        safe_headers = {}
+        for key, value in headers.items():
+            if str(key).strip().lower() == "authorization":
+                authorization_configured = bool(str(value or "").strip())
+            else:
+                safe_headers[key] = value
+        api_config["headers"] = safe_headers
+    safe_card["api_config"] = api_config
+    safe_card["authorization_configured"] = authorization_configured
+    return safe_card
+
+
+def preserve_api_card_authorization(
+    submitted_api_config: Any,
+    existing_api_config: Any,
+    *,
+    authorization_configured: Any = None,
+) -> Any:
+    """Preserve a write-only Authorization header during ordinary card edits."""
+    if submitted_api_config is None or not isinstance(submitted_api_config, dict):
+        return submitted_api_config
+    submitted = copy.deepcopy(submitted_api_config)
+    submitted_headers = submitted.get("headers")
+    if not isinstance(submitted_headers, dict):
+        submitted_headers = {}
+        submitted["headers"] = submitted_headers
+    if any(str(key).strip().lower() == "authorization" for key in submitted_headers):
+        return submitted
+    if authorization_configured is False:
+        return submitted
+
+    try:
+        existing = _coerce_api_config(existing_api_config)
+        existing_authorization = _authorization_value(existing.get("headers"))
+    except ValueError:
+        return submitted
+    submitted_headers["Authorization"] = existing_authorization
+    return submitted
+
+
+class ManagedApiCardContractValidator:
+    """Validate a card against the injected bridge URL, product map and token."""
+
+    def __init__(self, *, bridge_url: str,
+                 product_keys_by_spec: Mapping[str, str], bearer_token: str):
+        self._bridge_url = _normalize_private_bridge_url(bridge_url)
+        self._product_keys_by_spec = self._normalize_product_mapping(product_keys_by_spec)
+        self._bearer_token = self._validate_bearer_token(bearer_token)
+
+    def validate(self, card: Dict[str, Any], spec_value: str) -> str:
+        if not isinstance(card, dict) or card.get("type") != "api":
+            raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+        api_config = _coerce_api_config(card.get("api_config"))
+        try:
+            configured_url = _normalize_private_bridge_url(api_config.get("url"))
+        except ValueError as exc:
+            raise ValueError(MANAGED_CARD_CONFIG_INVALID) from exc
+        if configured_url != self._bridge_url:
+            raise ValueError(MANAGED_CARD_CONFIG_DRIFTED)
+        if str(api_config.get("method") or "").strip().upper() != "GET":
+            raise ValueError(MANAGED_CARD_CONFIG_DRIFTED)
+
+        normalized_spec = normalize_spec_text(spec_value)
+        expected_product_key = self._product_keys_by_spec.get(normalized_spec)
+        if not expected_product_key:
+            raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+        params = api_config.get("params")
+        if not isinstance(params, dict) or set(params) != {
+            "order_id", "product_key", "unit_index"
+        }:
+            raise ValueError(MANAGED_CARD_CONFIG_DRIFTED)
+        if (
+            params.get("order_id") != "{order_id}"
+            or str(params.get("unit_index")) != "1"
+            or str(params.get("product_key") or "").strip() != expected_product_key
+        ):
+            raise ValueError(MANAGED_CARD_CONFIG_DRIFTED)
+
+        authorization = _authorization_value(api_config.get("headers"))
+        expected_authorization = f"Bearer {self._bearer_token}"
+        if not hmac.compare_digest(authorization, expected_authorization):
+            raise ValueError(MANAGED_CARD_CONFIG_DRIFTED)
+        return fingerprint_managed_api_config(api_config)
+
+    @staticmethod
+    def _normalize_product_mapping(mapping: Mapping[str, str]) -> Dict[str, str]:
+        if not isinstance(mapping, Mapping) or not mapping:
+            raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+        normalized: Dict[str, str] = {}
+        for spec_value, product_key in mapping.items():
+            normalized_spec = normalize_spec_text(spec_value)
+            normalized_key = str(product_key or "").strip()
+            if (
+                not normalized_spec
+                or not _PRODUCT_KEY_PATTERN.fullmatch(normalized_key)
+                or normalized_spec in normalized
+            ):
+                raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+            normalized[normalized_spec] = normalized_key
+        if len(set(normalized.values())) != len(normalized):
+            raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+        return normalized
+
+    @staticmethod
+    def _validate_bearer_token(value: str) -> str:
+        token = str(value or "").strip()
+        lowered = token.lower()
+        if (
+            len(token) < 32
+            or any(marker in lowered for marker in _PLACEHOLDER_MARKERS)
+            or any(character.isspace() for character in token)
+        ):
+            raise ValueError(MANAGED_CARD_CONFIG_INVALID)
+        return token
