+        return {"success": True, **result, "trace_id": _visionforge_trace_id(request)}
+    except Exception as exc:
+        _raise_visionforge_error(request, exc, status_code=409)
+
+
+@app.post("/product-publish/visionforge/{operation_id}/deactivate")
+def deactivate_visionforge_binding(
