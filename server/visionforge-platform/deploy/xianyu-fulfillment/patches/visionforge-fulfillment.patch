+        )
+        return {"success": True, **result, "trace_id": _visionforge_trace_id(request)}
+    except Exception as exc:
+        _raise_visionforge_error(request, exc)
+
+
+@app.post("/product-publish/visionforge/{operation_id}/activate")
+def activate_visionforge_binding(
+    operation_id: str,
+    action: VisionForgeBindingActionRequest,
+    request: Request,
