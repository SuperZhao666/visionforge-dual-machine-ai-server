+                visionforge_fulfillment_service.mark_publish_failure(
+                    operation['id'], current_user['user_id'],
+                    error_code="PUBLISH_REQUEST_FAILED",
+                    error_message=mask_sensitive_text(detail),
+                )
+            except Exception:
+                logger.exception("记录VisionForge发布失败状态异常")
+        _raise_visionforge_error(request, exc, status_code=exc.status_code)
+    except Exception as exc:
+        if operation:
+            try:
+                visionforge_fulfillment_service.mark_publish_failure(
+                    operation['id'], current_user['user_id'],
+                    error_code=str(exc).split(':', 1)[0],
+                    error_message=mask_sensitive_text(exc),
+                )
+            except Exception:
+                logger.exception("记录VisionForge发布失败状态异常")
+        status_code = 409 if "PUBLISH_OUTCOME_UNKNOWN" in str(exc) else 400
+        _raise_visionforge_error(request, exc, status_code=status_code)
+
+
+@app.post("/product-publish/visionforge/{operation_id}/binding-dry-run")
+def dry_run_visionforge_binding(
+    operation_id: str,
+    request: Request,
