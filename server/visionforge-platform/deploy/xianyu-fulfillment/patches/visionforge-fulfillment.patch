+"""Pure rules for VisionForge multi-package listings and fulfillment safety."""
+
+from decimal import Decimal, InvalidOperation
+from dataclasses import dataclass
+from enum import Enum
+import json
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple
+
+
+MULTI_SKU_VALIDATION_ERROR_CODE = "PUBLISH_MULTI_SKU_INVALID"
+ORDER_QUANTITY_ERROR_CODE = "FULFILLMENT_SINGLE_UNIT_REQUIRED"
+ORDER_AMOUNT_ERROR_CODE = "FULFILLMENT_PRICE_MISMATCH"
+MONEY_QUANTUM = Decimal("0.01")
+MANAGED_ORDER_PRICE_BY_SPEC = {
+    "1小时": Decimal("0.75"),
+    "5小时": Decimal("3.00"),
+    "10小时": Decimal("5.00"),
+    "50小时": Decimal("20.00"),
+    "100小时": Decimal("35.00"),
+}
+
+
+class FulfillmentMode(str, Enum):
+    OFF = "off"
+    SHADOW = "shadow"
+    LIVE = "live"
+
+
+@dataclass(frozen=True)
+class CatalogConfig:
+    spec_name: str
+    spec_values: tuple
+    default_inventory: int
+    mode: FulfillmentMode
+
+    def __post_init__(self):
+        normalized_values = {
+            normalize_spec_text(value) for value in self.spec_values
+        }
+        if (
+            not str(self.spec_name or '').strip()
+            or len(self.spec_values) != 5
+            or len(normalized_values) != 5
+            or '' in normalized_values
+        ):
+            raise ValueError(
+                "CATALOG_CONFIG_INVALID: 必须配置一个规格名和五个唯一套餐值"
+            )
+        if not 1 <= int(self.default_inventory) <= 999999:
+            raise ValueError("CATALOG_CONFIG_INVALID: 默认库存超出范围")
+        if not isinstance(self.mode, FulfillmentMode):
+            raise ValueError("CATALOG_CONFIG_INVALID: 履约模式类型无效")
+
+
+def parse_fulfillment_mode(value: Any) -> FulfillmentMode:
+    try:
+        return FulfillmentMode(str(value or "").strip().lower())
+    except ValueError as exc:
+        raise ValueError(
+            "CATALOG_CONFIG_INVALID: 履约模式必须为 off、shadow 或 live"
+        ) from exc
+
+
+def normalize_spec_text(value: Any) -> str:
+    return str(value or "").strip().lower().replace(" ", "").replace("　", "")
+
+
+def build_item_sku_list(
+    spec_name: Optional[str],
+    variants: Sequence[Dict[str, Any]],
+) -> List[Dict[str, Any]]:
+    normalized_spec_name = str(spec_name or "").strip()
+    if not normalized_spec_name or len(normalized_spec_name) > 20:
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 规格名称长度必须为 1-20")
+    if not isinstance(variants, (list, tuple)) or not 2 <= len(variants) <= 10:
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 套餐数量必须为 2-10")
+
+    normalized_values = set()
+    return [
+        _build_item_sku(normalized_spec_name, variant, index, normalized_values)
+        for index, variant in enumerate(variants, start=1)
+    ]
+
+
+def _build_item_sku(
+    spec_name: str,
+    variant: Dict[str, Any],
+    index: int,
+    normalized_values: set,
+) -> Dict[str, Any]:
+    if not isinstance(variant, dict):
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐格式无效")
+
+    spec_value = str(variant.get("spec_value") or "").strip()
+    if not spec_value or len(spec_value) > 40:
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个规格值长度必须为 1-40")
+    normalized_value = normalize_spec_text(spec_value)
+    if normalized_value in normalized_values:
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 规格值不能重复")
+    normalized_values.add(normalized_value)
+
+    return {
+        "priceInCent": str(_parse_price_in_cent(variant.get("price"), index)),
+        "quantity": _parse_inventory(variant, index),
+        "propertyList": [{"propertyText": spec_name, "valueText": spec_value}],
+    }
+
+
+def _parse_price_in_cent(value: Any, index: int) -> int:
+    try:
+        price = Decimal(str(value))
+    except (InvalidOperation, TypeError, ValueError) as exc:
+        raise ValueError(
+            f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐价格必须是数字"
+        ) from exc
+    if not price.is_finite() or price <= 0 or price > Decimal("999999"):
+        raise ValueError(
+            f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐价格必须在 0-999999 之间"
+        )
+    if price.as_tuple().exponent < -2:
+        raise ValueError(
+            f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐价格最多保留两位小数"
+        )
+    return int(price * 100)
+
+
+def _parse_inventory(variant: Dict[str, Any], index: int) -> int:
+    raw_inventory = variant.get("inventory", variant.get("quantity"))
+    if raw_inventory in (None, ""):
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐必须填写库存")
+    if isinstance(raw_inventory, bool):
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐库存必须是正整数")
+    try:
+        inventory = int(raw_inventory)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(
+            f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐库存必须是正整数"
+        ) from exc
+    if str(raw_inventory).strip() != str(inventory) or not 1 <= inventory <= 999999:
+        raise ValueError(
+            f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 第 {index} 个套餐库存必须在 1-999999 之间"
+        )
+    return inventory
+
+
+def validate_single_unit_order_quantity(value: Any) -> int:
+    """Reject managed orders that could consume or issue more than one code."""
+    if value in (None, ""):
+        raise ValueError(f"{ORDER_QUANTITY_ERROR_CODE}: 订单购买数量无法确认")
+    try:
+        quantity = int(str(value).strip())
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"{ORDER_QUANTITY_ERROR_CODE}: 订单购买数量无法确认") from exc
+    if quantity != 1:
+        raise ValueError(f"{ORDER_QUANTITY_ERROR_CODE}: 托管套餐订单每次只能购买 1 件")
+    return quantity
+
+
+def parse_order_amount(value: Any) -> Decimal:
+    if value in (None, ""):
+        raise ValueError(f"{ORDER_AMOUNT_ERROR_CODE}: 订单实付金额无法确认")
+    text = str(value).strip().replace("￥", "").replace("¥", "").replace("元", "").replace(",", "")
+    multiplier = Decimal("1")
+    if text.endswith("万"):
+        text = text[:-1].strip()
+        multiplier = Decimal("10000")
+    try:
+        amount = Decimal(text) * multiplier
+    except (InvalidOperation, TypeError, ValueError) as exc:
+        raise ValueError(f"{ORDER_AMOUNT_ERROR_CODE}: 订单实付金额无法确认") from exc
+    if not amount.is_finite() or amount <= 0:
+        raise ValueError(f"{ORDER_AMOUNT_ERROR_CODE}: 订单实付金额无效")
+    return amount.quantize(MONEY_QUANTUM)
+
+
+def validate_managed_order_amount(spec_value: Any, amount: Any) -> Decimal:
+    normalized_spec = str(spec_value or "").strip()
+    expected = MANAGED_ORDER_PRICE_BY_SPEC.get(normalized_spec)
+    if expected is None:
+        raise ValueError(f"{ORDER_AMOUNT_ERROR_CODE}: 未配置套餐价格")
+    actual = parse_order_amount(amount)
+    if actual != expected:
+        raise ValueError(f"{ORDER_AMOUNT_ERROR_CODE}: 订单金额与套餐价格不一致")
+    return actual
+
+
+def build_binding_snapshot(card_spec: Sequence[Any]) -> Tuple[Optional[str], Optional[str], Optional[str], Optional[str], str]:
+    is_multi_spec, spec_name, spec_value, spec_name_2, spec_value_2 = card_spec
+    if not bool(is_multi_spec):
+        return None, None, None, None, "no_spec"
+
+    normalized_parts = tuple(
+        normalize_spec_text(value)
+        for value in (spec_name, spec_value, spec_name_2, spec_value_2)
+    )
+    if not normalized_parts[0] or not normalized_parts[1]:
+        raise ValueError("RULE_BINDING_CARD_SPEC_INVALID: 多规格卡缺少第一规格")
+    if bool(normalized_parts[2]) != bool(normalized_parts[3]):
+        raise ValueError("RULE_BINDING_CARD_SPEC_INVALID: 第二规格必须同时填写名称和值")
+
+    return (
+        str(spec_name).strip(),
+        str(spec_value).strip(),
+        str(spec_name_2 or "").strip() or None,
+        str(spec_value_2 or "").strip() or None,
+        json.dumps(normalized_parts, ensure_ascii=False, separators=(",", ":")),
+    )
+
+
+def build_order_spec_key(
+    spec_name: Any,
+    spec_value: Any,
+    spec_name_2: Any = None,
+    spec_value_2: Any = None,
+) -> str:
+    parts = tuple(
+        normalize_spec_text(value)
+        for value in (spec_name, spec_value, spec_name_2, spec_value_2)
+    )
+    if not parts[0] or not parts[1] or bool(parts[2]) != bool(parts[3]):
+        raise ValueError("RULE_MATCH_SPEC_INVALID: 订单规格不完整")
+    return json.dumps(parts, ensure_ascii=False, separators=(",", ":"))
+
+
+def minimum_variant_price(variants: Iterable[Dict[str, Any]]) -> Decimal:
+    variant_list = list(variants)
+    if not variant_list:
+        raise ValueError(f"{MULTI_SKU_VALIDATION_ERROR_CODE}: 缺少套餐价格")
+    prices = [Decimal(_parse_price_in_cent(variant.get("price"), index + 1)) / 100 for index, variant in enumerate(variant_list)]
+    return min(prices)
