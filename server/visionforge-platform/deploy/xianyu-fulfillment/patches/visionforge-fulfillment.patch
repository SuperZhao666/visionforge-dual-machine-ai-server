@@ -0,0 +1,764 @@
+"""VisionForge catalog, exact binding, and operation state application service."""
+
+from enum import Enum
+import hashlib
+import json
+import re
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Set
+import uuid
+
+from domain.visionforge_catalog import (
+    CatalogConfig,
+    FulfillmentMode,
+    build_binding_snapshot,
+    build_item_sku_list,
+    normalize_spec_text,
+)
+from domain.visionforge_fulfillment_security import mask_sensitive_fulfillment_text
+
+
+class OperationStatus(str, Enum):
+    VALIDATING = "validating"
+    PUBLISHING = "publishing"
+    PUBLISH_OUTCOME_UNKNOWN = "publish_outcome_unknown"
+    FAILED_PRE_PUBLISH = "failed_pre_publish"
+    PUBLISHED_UNBOUND = "published_unbound"
+    REQUIRES_ACTIVATION = "requires_activation"
+    BOUND = "bound"
+    DEACTIVATED = "deactivated"
+
+
+class VisionForgeFulfillmentService:
+    def __init__(self, repository, config: CatalogConfig,
+                 capabilities_gateway=None, managed_card_validator=None):
+        self.repository = repository
+        self.config = config
+        self.capabilities_gateway = capabilities_gateway
+        self.managed_card_validator = managed_card_validator
+
+    async def get_publish_capabilities(self, user_id: int,
+                                       account_id: str) -> Dict[str, Any]:
+        self._assert_account_access(user_id, account_id)
+        if self.capabilities_gateway is None:
+            raise RuntimeError("PUBLISH_CAPABILITIES_UNAVAILABLE: 发布能力网关未配置")
+        capabilities = await self.capabilities_gateway.get_capabilities(
+            user_id,
+            str(account_id).strip(),
+        )
+        return {**capabilities, "mode": self.config.mode.value}
+
+    def mark_item_as_multi_spec(self, user_id: int, account_id: str,
+                                item_id: str) -> bool:
+        self._assert_account_access(user_id, account_id)
+        if not self.repository.update_item_multi_spec_status(account_id, item_id, True):
+            return False
+        return True
+
+    def dry_run_single_spec(self, user_id: int, account_id: str, item_id: str,
+                            *, spec_name: str = None, spec_value: str = None,
+                            spec_name_2: str = None,
+                            spec_value_2: str = None) -> Dict[str, Any]:
+        self._assert_account_access(user_id, account_id)
+        resolution = self.repository.resolve_exact_delivery_rule(
+            user_id=user_id,
+            account_id=account_id,
+            item_id=item_id,
+            spec_name=spec_name,
+            spec_value=spec_value,
+            spec_name_2=spec_name_2,
+            spec_value_2=spec_value_2,
+            include_disabled=True,
+        )
+        return self._safe_resolution(spec_value or '', resolution)
+
+    def get_catalog(self, user_id: int) -> Dict[str, Any]:
+        expected = {normalize_spec_text(value): value for value in self.config.spec_values}
+        candidates = []
+        coverage = {value: [] for value in self.config.spec_values}
+        for card in self.repository.get_all_cards(user_id):
+            if not self._is_catalog_candidate(card, expected):
+                continue
+            safe_card = self._safe_card(card)
+            candidates.append(safe_card)
+            coverage[expected[normalize_spec_text(card.get('spec_value'))]].append(safe_card['id'])
+
+        missing = [value for value, card_ids in coverage.items() if not card_ids]
+        ambiguous = [value for value, card_ids in coverage.items() if len(card_ids) > 1]
+        status = "ready" if not missing and not ambiguous else "invalid"
+        return {
+            "status": status,
+            "mode": self.config.mode.value,
+            "spec_name": self.config.spec_name,
+            "expected_spec_values": list(self.config.spec_values),
+            "default_inventory": self.config.default_inventory,
+            "cards": candidates,
+            "coverage": coverage,
+            "missing_spec_values": missing,
+            "ambiguous_spec_values": ambiguous,
+        }
+
+    def _is_catalog_candidate(self, card: Dict[str, Any], expected: Dict[str, str]) -> bool:
+        return bool(
+            card.get('enabled')
+            and card.get('type') == 'api'
+            and card.get('is_multi_spec')
+            and normalize_spec_text(card.get('spec_name')) == normalize_spec_text(self.config.spec_name)
+            and normalize_spec_text(card.get('spec_value')) in expected
+            and not normalize_spec_text(card.get('spec_name_2'))
+            and not normalize_spec_text(card.get('spec_value_2'))
+        )
+
+    @staticmethod
+    def _safe_card(card: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            "id": card.get('id'),
+            "name": card.get('name'),
+            "type": card.get('type'),
+            "enabled": bool(card.get('enabled')),
+            "spec_name": card.get('spec_name'),
+            "spec_value": card.get('spec_value'),
+        }
+
+    def normalize_variants(self, user_id: int, variants: Sequence[Dict[str, Any]], *,
+                           require_price: bool) -> List[Dict[str, Any]]:
+        if not isinstance(variants, (list, tuple)) or len(variants) != len(self.config.spec_values):
+            raise ValueError("CATALOG_COVERAGE_INVALID: 必须提交完整五套餐")
+
+        cards_by_id = {card['id']: card for card in self.repository.get_all_cards(user_id)}
+        normalized = []
+        seen_card_ids = set()
+        for variant in variants:
+            normalized.append(
+                self._normalize_variant(cards_by_id, variant, seen_card_ids, require_price=require_price)
+            )
+        self._assert_exact_coverage(normalized)
+        if require_price:
+            build_item_sku_list(self.config.spec_name, normalized)
+        return normalized
+
+    def validate_spec_name(self, submitted_spec_name: Optional[str]) -> str:
+        if submitted_spec_name is None:
+            return self.config.spec_name
+        if normalize_spec_text(submitted_spec_name) != normalize_spec_text(self.config.spec_name):
+            raise ValueError(
+                "MANAGED_SPEC_NAME_MISMATCH: 提交的规格名称与服务端配置不一致"
+            )
+        return self.config.spec_name
+
+    def _normalize_variant(self, cards_by_id: Dict[int, Dict[str, Any]], variant: Dict[str, Any],
+                           seen_card_ids: Set[int], *, require_price: bool) -> Dict[str, Any]:
+        if not isinstance(variant, dict):
+            raise ValueError("CATALOG_VARIANT_INVALID: 套餐格式无效")
+        try:
+            card_id = int(variant.get('card_id'))
+        except (TypeError, ValueError) as exc:
+            raise ValueError("CATALOG_CARD_REQUIRED: 每个套餐必须选择卡券") from exc
+        if card_id in seen_card_ids:
+            raise ValueError("CATALOG_DUPLICATE_CARD: 同一张卡券不能绑定多个套餐")
+        seen_card_ids.add(card_id)
+
+        card = cards_by_id.get(card_id)
+        expected = {normalize_spec_text(value) for value in self.config.spec_values}
+        if not card or not self._is_catalog_candidate(card, {value: value for value in expected}):
+            raise ValueError("CATALOG_CARD_INVALID: 卡券不是已配置的 VisionForge 多规格 API 卡")
+        submitted_spec_value = normalize_spec_text(variant.get('spec_value'))
+        if submitted_spec_value != normalize_spec_text(card.get('spec_value')):
+            raise ValueError("CATALOG_CARD_SPEC_MISMATCH: card_id 与规格值不一致")
+        if self.managed_card_validator is None:
+            raise ValueError(
+                "MANAGED_CARD_CONTRACT_UNAVAILABLE: 即时发码安全契约未配置"
+            )
+        contract_fingerprint = self.managed_card_validator.validate(
+            card,
+            str(card.get('spec_value') or '').strip(),
+        )
+
+        normalized = {
+            "card_id": card_id,
+            "spec_value": str(card.get('spec_value')).strip(),
+            "inventory": variant.get('inventory', self.config.default_inventory),
+            "managed_card_config_fingerprint": contract_fingerprint,
+        }
+        if require_price:
+            normalized["price"] = variant.get('price')
+        return normalized
+
+    def _assert_exact_coverage(self, variants: Sequence[Dict[str, Any]]):
+        submitted = {normalize_spec_text(variant.get('spec_value')) for variant in variants}
+        expected = {normalize_spec_text(value) for value in self.config.spec_values}
+        if submitted != expected:
+            raise ValueError("CATALOG_COVERAGE_INVALID: 套餐规格必须与服务端配置完全一致")
+
+    def build_bindings(self, user_id: int, variants: Sequence[Dict[str, Any]]) -> List[Dict[str, Any]]:
+        normalized = self.normalize_variants(user_id, variants, require_price=False)
+        bindings = []
+        for variant in normalized:
+            snapshot = build_binding_snapshot((True, self.config.spec_name, variant['spec_value'], None, None))
+            bindings.append({
+                "card_id": variant['card_id'],
+                "spec_name": snapshot[0],
+                "spec_value": snapshot[1],
+                "spec_name_2": snapshot[2],
+                "spec_value_2": snapshot[3],
+                "binding_spec_key": snapshot[4],
+                "managed_card_config_fingerprint": variant[
+                    'managed_card_config_fingerprint'
+                ],
+            })
+        return bindings
+
+    def prepare_publish_operation(self, user_id: int, account_id: str, client_request_id: str,
+                                  publish_data: Dict[str, Any], variants: Sequence[Dict[str, Any]],
+                                  spec_name: Optional[str] = None) -> Dict[str, Any]:
+        self.assert_external_publish_allowed()
+        self._assert_account_access(user_id, account_id)
+        self.validate_spec_name(spec_name)
+        normalized_variants = self.normalize_variants(user_id, variants, require_price=True)
+        payload = self._build_safe_publish_fingerprint(publish_data, normalized_variants)
+        operation = self.repository.create_or_get_visionforge_operation(
+            operation_id=str(uuid.uuid4()),
+            user_id=user_id,
+            client_request_id=self._normalize_client_request_id(client_request_id),
+            operation_type="publish",
+            account_id=account_id,
+            item_id=None,
+            status=OperationStatus.VALIDATING.value,
+            payload=payload,
+        )
+        return {"operation": operation, "variants": normalized_variants}
+
+    def _build_safe_publish_fingerprint(self, publish_data: Dict[str, Any],
+                                        variants: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
+        request_hash = hashlib.sha256(
+            json.dumps(
+                publish_data,
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(',', ':'),
+                default=str,
+            ).encode('utf-8')
+        ).hexdigest()
+        images = publish_data.get('images') or []
+        image_hashes = [
+            hashlib.sha256(
+                json.dumps(image, sort_keys=True, default=str, separators=(',', ':')).encode('utf-8')
+            ).hexdigest()
+            for image in images
+        ]
+        return {
+            "request_hash": request_hash,
+            "title_hash": hashlib.sha256(str(publish_data.get('title') or '').encode('utf-8')).hexdigest(),
+            "image_count": len(images),
+            "image_hashes": image_hashes,
+            "variants": [
+                {
+                    "card_id": variant['card_id'],
+                    "spec_value": variant['spec_value'],
+                    "price": str(variant['price']),
+                    "inventory": variant['inventory'],
+                }
+                for variant in variants
+            ],
+        }
+
+    def mark_external_publish_start(self, operation: Dict[str, Any], user_id: int) -> Dict[str, Any]:
+        if operation['status'] == OperationStatus.PUBLISHING.value:
+            raise ValueError("PUBLISH_OUTCOME_UNKNOWN: 上次发布结果未知，必须先同步或人工关联商品")
+        if operation['status'] in {
+            OperationStatus.PUBLISH_OUTCOME_UNKNOWN.value,
+            OperationStatus.PUBLISHED_UNBOUND.value,
+            OperationStatus.REQUIRES_ACTIVATION.value,
+            OperationStatus.BOUND.value,
+        }:
+            raise ValueError("OPERATION_STATE_INVALID: 当前状态禁止再次发布")
+        return self.repository.update_visionforge_operation(
+            operation['id'], user_id,
+            expected_version=operation['version'],
+            status=OperationStatus.PUBLISHING.value,
+        )
+
+    def mark_publish_failure(self, operation_id: str, user_id: int, *,
+                             error_code: str, error_message: str) -> Dict[str, Any]:
+        operation = self.repository.get_visionforge_operation(operation_id, user_id)
+        if not operation:
+            raise ValueError("OPERATION_NOT_FOUND: 操作不存在")
+        if operation['status'] not in {
+            OperationStatus.VALIDATING.value,
+            OperationStatus.PUBLISHING.value,
+            OperationStatus.FAILED_PRE_PUBLISH.value,
+        }:
+            return operation
+        target_status = (
+            OperationStatus.PUBLISH_OUTCOME_UNKNOWN
+            if operation['status'] == OperationStatus.PUBLISHING.value
+            else OperationStatus.FAILED_PRE_PUBLISH
+        )
+        return self.repository.update_visionforge_operation(
+            operation_id, user_id,
+            expected_version=operation['version'],
+            status=target_status.value,
+            error_code=self._safe_error_code(error_code),
+            error_message=self._safe_error_summary(error_message),
+        )
+
+    def mark_published_unbound(self, operation_id: str, user_id: int, *,
+                               item_id: str, publish_log_id: int = None) -> Dict[str, Any]:
+        operation = self.repository.get_visionforge_operation(operation_id, user_id)
+        if not operation or operation['status'] != OperationStatus.PUBLISHING.value:
+            raise ValueError("OPERATION_STATE_INVALID: 发布操作状态不允许登记结果")
+        return self.repository.update_visionforge_operation(
+            operation_id, user_id,
+            expected_version=operation['version'],
+            status=OperationStatus.PUBLISHED_UNBOUND.value,
+            item_id=item_id,
+            publish_log_id=publish_log_id,
+        )
+
+    def bind_published_operation(self, operation: Dict[str, Any], user_id: int,
+                                 variants: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
+        if operation['status'] != OperationStatus.PUBLISHED_UNBOUND.value or not operation.get('item_id'):
+            raise ValueError("OPERATION_STATE_INVALID: 当前状态不允许重试绑定")
+        bindings = self.build_bindings(user_id, variants)
+        result = self.repository.bind_managed_multi_spec_rules(
+            user_id=user_id,
+            managed_operation_id=operation['id'],
+            account_id=operation['account_id'],
+            item_id=operation['item_id'],
+            bindings=bindings,
+        )
+        updated = result.pop('operation')
+        response = self._public_operation(updated)
+        response.update(result)
+        return response
+
+    def attach_and_bind_published(self, operation: Dict[str, Any], user_id: int,
+                                  variants: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
+        if not self.repository.update_item_multi_spec_status(
+            operation['account_id'], operation.get('item_id'), True,
+        ):
+            response = self.public_operation(operation)
+            response.update({
+                "binding_error_code": "PUBLISHED_ITEM_NOT_SYNCED",
+                "requires_activation": True,
+                "rules_active": False,
+            })
+            return response
+        return self.bind_published_operation(operation, user_id, variants)
+
+    def complete_publish_and_bind(self, operation_id: str, user_id: int, *, item_id: str,
+                                  publish_log_id: int, variants: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
+        operation = self.mark_published_unbound(
+            operation_id, user_id, item_id=item_id, publish_log_id=publish_log_id,
+        )
+        return self.attach_and_bind_published(operation, user_id, variants)
+
+    def dry_run_operation(self, operation_id: str, user_id: int) -> Dict[str, Any]:
+        operation = self.repository.get_visionforge_operation(operation_id, user_id)
+        if not operation or not operation.get('item_id'):
+            raise ValueError("OPERATION_NOT_FOUND: 操作不存在或尚未关联商品")
+        result = self.dry_run(
+            user_id,
+            operation['account_id'],
+            operation['item_id'],
+            include_disabled=True,
+            managed_operation_id=operation['id'],
+        )
+        result.update({
+            "operation_id": operation['id'],
+            "operation_version": operation['version'],
+            "version": operation['version'],
+            "status": operation['status'],
+            "requires_activation": operation['status'] in {
+                OperationStatus.REQUIRES_ACTIVATION.value,
+                OperationStatus.DEACTIVATED.value,
+            },
+            "rules_active": operation['status'] == OperationStatus.BOUND.value,
+        })
+        return result
+
+    def public_operation(self, operation: Dict[str, Any]) -> Dict[str, Any]:
+        result = self._public_operation(operation)
+        result.update({
+            "published_item_id": operation.get('item_id'),
+        })
+        return result
+
+    def list_synced_items(self, user_id: int, account_id: str) -> List[Dict[str, Any]]:
+        self._assert_account_access(user_id, account_id)
+        items = self.repository.get_items_by_cookie(account_id)
+        return [self._safe_synced_item(item) for item in items]
+
+    def _safe_synced_item(self, item: Dict[str, Any]) -> Dict[str, Any]:
+        actual_spec_values = self._extract_spec_values(item.get('item_detail_parsed'))
+        is_service_option_item = self._is_service_option_item(item)
+        is_bindable_spec_item = bool(item.get('is_multi_spec')) or is_service_option_item
+        spec_values = sorted(actual_spec_values)
+        spec_values_status = "known" if actual_spec_values else "unknown"
+        if is_service_option_item and not actual_spec_values:
+            spec_values = list(self.config.spec_values)
+            spec_values_status = "service_option"
+        return {
+            "item_id": item.get('item_id'),
+            "title": item.get('item_title'),
+            "is_multi_spec": is_bindable_spec_item,
+            "is_service_option_item": is_service_option_item,
+            "multi_spec_source": "service_option" if is_service_option_item else "standard_sku",
+            "spec_name": self.config.spec_name if spec_values or is_service_option_item else None,
+            "spec_values_status": spec_values_status,
+            "spec_values": spec_values,
+        }
+
+    def _extract_spec_values(self, node: Any) -> Set[str]:
+        found = set()
+        if isinstance(node, dict):
+            property_list = node.get('propertyList')
+            if isinstance(property_list, list):
+                for prop in property_list:
+                    if not isinstance(prop, dict):
+                        continue
+                    if normalize_spec_text(prop.get('propertyText')) == normalize_spec_text(self.config.spec_name):
+                        value = str(prop.get('valueText') or '').strip()
+                        if value:
+                            found.add(value)
+            for value in node.values():
+                found.update(self._extract_spec_values(value))
+        elif isinstance(node, list):
+            for value in node:
+                found.update(self._extract_spec_values(value))
+        return found
+
+    def _is_service_option_item(self, item: Dict[str, Any]) -> bool:
+        detail = item.get('item_detail_parsed') or {}
+        return self._contains_service_option_marker(detail)
+
+    def _contains_service_option_marker(self, node: Any) -> bool:
+        if isinstance(node, dict):
+            for key, value in node.items():
+                key_text = str(key or '').strip().lower()
+                value_text = str(value or '').strip().lower()
+                if key_text == 'isskillproductitem' and value_text == 'true':
+                    return True
+                if key_text == 'card_type' and value_text == '1003':
+                    return True
+                if key_text in {'detail_url', 'detailurl'} and 'isskill=true' in str(value):
+                    return True
+                if self._contains_service_option_marker(value):
+                    return True
+        elif isinstance(node, list):
+            for value in node:
+                if self._contains_service_option_marker(value):
+                    return True
+        return False
+
+    def validate_existing_binding(self, user_id: int, account_id: str, item_id: str,
+                                  variants: Sequence[Dict[str, Any]],
+                                  spec_name: Optional[str] = None) -> Dict[str, Any]:
+        self._assert_account_access(user_id, account_id)
+        self.validate_spec_name(spec_name)
+        item = self.repository.get_item_info(account_id, item_id)
+        if not item:
+            raise ValueError("MANAGED_ITEM_NOT_FOUND: 商品不存在、未同步或尚未标记为多规格")
+        is_service_option_item = self._is_service_option_item(item)
+        if not bool(item.get('is_multi_spec')) and not is_service_option_item:
+            raise ValueError("MANAGED_ITEM_NOT_FOUND: 商品不存在、未同步或尚未标记为多规格")
+        bindings = self.build_bindings(user_id, variants)
+        actual_values = self._extract_spec_values(item.get('item_detail_parsed'))
+        expected_values = {normalize_spec_text(value) for value in self.config.spec_values}
+        actual_normalized = {normalize_spec_text(value) for value in actual_values}
+        if actual_normalized and actual_normalized != expected_values:
+            raise ValueError(
+                "MANAGED_ITEM_SKU_MISMATCH: 已同步商品规格与服务端五套餐配置不一致"
+            )
+        coverage_verified = bool(actual_normalized)
+        coverage = self._coverage(
+            expected=len(self.config.spec_values),
+            bound=len(bindings),
+            duplicate=0,
+        )
+        return {
+            "valid": True,
+            "coverage_verified": coverage_verified,
+            "binding_status": (
+                "ready" if coverage_verified
+                else "service_option" if is_service_option_item
+                else "spec_values_unknown"
+            ),
+            "coverage": coverage,
+            "bindings": bindings,
+        }
+
+    def bind_existing(self, user_id: int, account_id: str, item_id: str,
+                      client_request_id: str, variants: Sequence[Dict[str, Any]],
+                      spec_name: Optional[str] = None) -> Dict[str, Any]:
+        if self.config.mode == FulfillmentMode.OFF:
+            raise ValueError("MANAGED_FULFILLMENT_OFF: 当前已关闭托管履约变更")
+        validation = self.validate_existing_binding(
+            user_id,
+            account_id,
+            item_id,
+            variants,
+            spec_name=spec_name,
+        )
+        payload = {
+            "account_id": str(account_id).strip(),
+            "item_id": str(item_id).strip(),
+            "variants": list(variants),
+        }
+        operation = self.repository.create_or_get_visionforge_operation(
+            operation_id=str(uuid.uuid4()),
+            user_id=user_id,
+            client_request_id=self._normalize_client_request_id(client_request_id),
+            operation_type="bind_existing",
+            account_id=account_id,
+            item_id=item_id,
+            status=OperationStatus.VALIDATING.value,
+            payload=payload,
+        )
+        rebindable_statuses = {
+            OperationStatus.VALIDATING.value,
+            OperationStatus.REQUIRES_ACTIVATION.value,
+            OperationStatus.BOUND.value,
+            OperationStatus.DEACTIVATED.value,
+        }
+        if operation['status'] not in rebindable_statuses:
+            return self._public_operation(operation)
+
+        result = self.repository.bind_managed_multi_spec_rules(
+            user_id=user_id,
+            managed_operation_id=operation['id'],
+            account_id=account_id,
+            item_id=item_id,
+            bindings=validation['bindings'],
+        )
+        operation = result.pop('operation')
+        response = self.public_operation(operation)
+        response.update(result)
+        response["coverage_verified"] = validation['coverage_verified']
+        response["coverage"] = validation['coverage']
+        return response
+
+    def dry_run(self, user_id: int, account_id: str, item_id: str,
+                *, include_disabled: bool = True,
+                managed_operation_id: str = None) -> Dict[str, Any]:
+        results = []
+        for spec_value in self.config.spec_values:
+            resolution = self.repository.resolve_exact_delivery_rule(
+                user_id=user_id,
+                account_id=account_id,
+                item_id=item_id,
+                spec_name=self.config.spec_name,
+                spec_value=spec_value,
+                include_disabled=include_disabled,
+                managed_operation_id=managed_operation_id,
+            )
+            results.append(self._safe_resolution(spec_value, resolution))
+        statuses = {result['status'] for result in results}
+        bound = sum(
+            1 for result in results if result['status'] in {"matched", "disabled"}
+        )
+        duplicate = sum(1 for result in results if result['status'] == "ambiguous")
+        coverage = self._coverage(
+            expected=len(self.config.spec_values),
+            bound=bound,
+            duplicate=duplicate,
+        )
+        valid = (
+            coverage['missing'] == 0
+            and coverage['duplicate'] == 0
+            and statuses.issubset({"matched", "disabled"})
+        )
+        return {
+            "status": "matched" if statuses == {"matched"} else "blocked",
+            "valid": valid,
+            "coverage": coverage,
+            "item_id": str(item_id).strip(),
+            "results": results,
+        }
+
+    def activate(self, user_id: int, operation_id: str, version: int, confirmed: bool) -> Dict[str, Any]:
+        if self.config.mode != FulfillmentMode.LIVE:
+            raise ValueError("MANAGED_FULFILLMENT_NOT_LIVE: 只有 live 模式允许启用自动发货")
+        if not confirmed:
+            raise ValueError("ACTIVATION_CONFIRMATION_REQUIRED: 必须明确确认后才能启用自动发货")
+        operation = self._get_operation(operation_id, user_id, version)
+        if operation['status'] not in {OperationStatus.REQUIRES_ACTIVATION.value, OperationStatus.DEACTIVATED.value}:
+            raise ValueError("OPERATION_STATE_INVALID: 当前状态不允许启用")
+        if not operation.get('item_id'):
+            raise ValueError("OPERATION_ITEM_REQUIRED: 操作尚未关联商品")
+        dry_run = self.dry_run(
+            user_id,
+            operation['account_id'],
+            operation['item_id'],
+            include_disabled=True,
+            managed_operation_id=operation['id'],
+        )
+        invalid = [result for result in dry_run['results'] if result['status'] not in {'matched', 'disabled'}]
+        if invalid or len(dry_run['results']) != len(self.config.spec_values):
+            raise ValueError("RULE_BINDING_NOT_ACTIVATABLE: coverage、卡状态或规格漂移校验未通过")
+        self._validate_current_card_contracts(user_id, dry_run['results'])
+        transition = self.repository.transition_managed_multi_spec_rules(
+            user_id=user_id,
+            managed_operation_id=operation_id,
+            expected_version=version,
+            expected_statuses=[
+                OperationStatus.REQUIRES_ACTIVATION.value,
+                OperationStatus.DEACTIVATED.value,
+            ],
+            target_status=OperationStatus.BOUND.value,
+            enabled=True,
+            expected_count=len(self.config.spec_values),
+        )
+        updated = transition['operation']
+        return self.public_operation(updated)
+
+    def _validate_current_card_contracts(
+        self,
+        user_id: int,
+        dry_run_results: Sequence[Dict[str, Any]],
+    ) -> None:
+        if self.managed_card_validator is None:
+            raise ValueError(
+                "MANAGED_CARD_CONTRACT_UNAVAILABLE: 即时发码安全契约未配置"
+            )
+        cards_by_id = {
+            int(card['id']): card
+            for card in self.repository.get_all_cards(user_id)
+            if card.get('id') is not None
+        }
+        for result in dry_run_results:
+            matched_cards = result.get('cards') or []
+            if len(matched_cards) != 1:
+                raise ValueError(
+                    "RULE_BINDING_NOT_ACTIVATABLE: 托管套餐没有唯一卡券"
+                )
+            card_id = int(matched_cards[0].get('card_id') or 0)
+            card = cards_by_id.get(card_id)
+            if not card:
+                raise ValueError(
+                    "RULE_BINDING_NOT_ACTIVATABLE: 托管卡券不存在或无权访问"
+                )
+            self.managed_card_validator.validate(card, result.get('spec_value'))
+
+    def deactivate(self, user_id: int, operation_id: str, version: int, confirmed: bool) -> Dict[str, Any]:
+        if not confirmed:
+            raise ValueError("DEACTIVATION_CONFIRMATION_REQUIRED: 必须明确确认后才能停用自动发货")
+        operation = self._get_operation(operation_id, user_id, version)
+        if operation['status'] not in {
+            OperationStatus.BOUND.value,
+            OperationStatus.REQUIRES_ACTIVATION.value,
+        }:
+            raise ValueError("OPERATION_STATE_INVALID: 当前状态不允许停用")
+        if not operation.get('item_id'):
+            raise ValueError("OPERATION_ITEM_REQUIRED: 操作尚未关联商品")
+        transition = self.repository.transition_managed_multi_spec_rules(
+            user_id=user_id,
+            managed_operation_id=operation_id,
+            expected_version=version,
+            expected_statuses=[
+                OperationStatus.BOUND.value,
+                OperationStatus.REQUIRES_ACTIVATION.value,
+            ],
+            target_status=OperationStatus.DEACTIVATED.value,
+            enabled=False,
+            expected_count=len(self.config.spec_values),
+        )
+        updated = transition['operation']
+        return self.public_operation(updated)
+
+    def assert_external_publish_allowed(self):
+        if self.config.mode != FulfillmentMode.LIVE:
+            raise ValueError("MANAGED_FULFILLMENT_NOT_LIVE: 只有 live 模式允许真实发布")
+
+    def _assert_account_access(self, user_id: int, account_id: str):
+        if str(account_id or '').strip() not in self.repository.get_all_cookies(user_id):
+            raise ValueError("ACCOUNT_FORBIDDEN: 账号不存在或无权访问")
+
+    def _get_operation(self, operation_id: str, user_id: int, version: int) -> Dict[str, Any]:
+        operation = self.repository.get_visionforge_operation(operation_id, user_id)
+        if not operation:
+            raise ValueError("OPERATION_NOT_FOUND: 操作不存在")
+        if operation['version'] != version:
+            raise ValueError("OPERATION_VERSION_CONFLICT: 操作状态已变化，请刷新后重试")
+        return operation
+
+    @staticmethod
+    def _normalize_client_request_id(value: str) -> str:
+        normalized = str(value or '').strip()
+        if not normalized or len(normalized) > 128:
+            raise ValueError("CLIENT_REQUEST_ID_INVALID: client_request_id 长度必须为 1-128")
+        return normalized
+
+    @staticmethod
+    def _safe_error_code(value: Any) -> str:
+        code = str(value or '').strip().upper()
+        if not re.fullmatch(r"[A-Z][A-Z0-9_]{2,80}", code):
+            return "VISIONFORGE_OPERATION_FAILED"
+        return code
+
+    @staticmethod
+    def _safe_error_summary(value: Any) -> str:
+        text = str(value or '')
+        text = re.sub(
+            r"(?i)(cookie|token|access_token|refresh_token|authorization|api[_-]?key|password)\s*[:=]\s*[^\s,;]+",
+            r"\1=***",
+            text,
+        )
+        text = re.sub(
+            r"(?i)((?:authorization\s*:\s*)?bearer\s+)[A-Za-z0-9._~+/=-]+",
+            r"\1***",
+            text,
+        )
+        text = re.sub(
+            r"(?i)data:image/[^;,]+;base64,[A-Za-z0-9+/=]+",
+            "[inline-image-omitted]",
+            text,
+        )
+        text = re.sub(r"[A-Za-z0-9+/=]{256,}", "[long-secret-omitted]", text)
+        return mask_sensitive_fulfillment_text(text)[:500]
+
+    @staticmethod
+    def _safe_resolution(spec_value: str, resolution: Dict[str, Any]) -> Dict[str, Any]:
+        safe_rules = [
+            {
+                "rule_id": rule.get('id'),
+                "card_id": rule.get('card_id'),
+                "card_name": rule.get('card_name'),
+                "card_type": rule.get('card_type'),
+                "enabled": bool(rule.get('enabled') and rule.get('card_enabled')),
+                "binding_drifted": bool(rule.get('binding_drifted')),
+            }
+            for rule in resolution.get('rules', [])
+        ]
+        return {
+            "spec_value": spec_value,
+            "status": resolution.get('status'),
+            "error_code": resolution.get('error_code'),
+            "cards": safe_rules,
+        }
+
+    @staticmethod
+    def _coverage(*, expected: int, bound: int, duplicate: int) -> Dict[str, int]:
+        return {
+            "expected": int(expected),
+            "bound": int(bound),
+            "missing": max(0, int(expected) - int(bound)),
+            "duplicate": int(duplicate),
+        }
+
+    @staticmethod
+    def _public_operation(operation: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            "operation_id": operation['id'],
+            "status": operation['status'],
+            "version": operation['version'],
+            "operation_version": operation['version'],
+            "account_id": operation['account_id'],
+            "item_id": operation['item_id'],
+            "requires_activation": operation['status'] in {
+                OperationStatus.REQUIRES_ACTIVATION.value,
+                OperationStatus.DEACTIVATED.value,
+            },
+            "rules_active": operation['status'] == OperationStatus.BOUND.value,
+            "error_code": operation.get('error_code'),
+            "error_message": operation.get('error_message'),
+        }
