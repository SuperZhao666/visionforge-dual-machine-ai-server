+        for old_operation_id in old_operation_ids:
+            old_operation = self._get_visionforge_operation_row(
+                cursor, old_operation_id, user_id,
+            )
+            self._update_visionforge_operation_row(
+                cursor,
+                operation=old_operation,
+                status="deactivated",
+            )
+
+    def _validate_managed_binding_cards(self, cursor, user_id: int, bindings: List[Dict[str, Any]]):
+        if not isinstance(bindings, list) or not 2 <= len(bindings) <= 10:
+            raise ValueError("RULE_BINDING_COVERAGE_INVALID: 精确绑定数量必须为 2-10")
+        seen_card_ids = set()
+        seen_spec_keys = set()
+        normalized_bindings = []
+        for binding in bindings:
+            card_id = int(binding.get('card_id') or 0)
+            if card_id in seen_card_ids:
+                raise ValueError("RULE_BINDING_DUPLICATE_CARD: 同一张卡券不能重复绑定")
+            seen_card_ids.add(card_id)
+            self._execute_sql(
+                cursor,
+                """
+                SELECT type, enabled, is_multi_spec, spec_name, spec_value, spec_name_2,
+                       spec_value_2, api_config
+                FROM cards WHERE id = ? AND user_id = ?
+                """,
+                (card_id, user_id),
+            )
+            card = cursor.fetchone()
+            if not card or card[0] != 'api' or not bool(card[1]) or not bool(card[2]):
+                raise ValueError("RULE_BINDING_CARD_INVALID: 只能绑定当前用户已启用的多规格 API 卡")
+            self._execute_sql(
+                cursor,
+                """
+                SELECT 1 FROM delivery_rules
+                WHERE card_id = ? AND user_id = ? AND COALESCE(is_managed, 0) = 0
+                LIMIT 1
+                """,
+                (card_id, user_id),
+            )
+            if cursor.fetchone():
+                raise ValueError(
+                    "MANAGED_RULE_REQUIRES_WORKFLOW: 通用规则引用中的卡券不能加入托管绑定"
+                )
+            snapshot = build_binding_snapshot(card[2:7])
+            if snapshot[4] != str(binding.get('binding_spec_key') or ''):
+                raise ValueError("RULE_BINDING_CARD_DRIFTED: 卡券规格与提交快照不一致")
+            if snapshot[4] in seen_spec_keys:
+                raise ValueError("RULE_BINDING_DUPLICATE_SPEC: 同一商品规格只能绑定一张卡券")
+            seen_spec_keys.add(snapshot[4])
+            current_config_fingerprint = fingerprint_managed_api_config(card[7])
+            submitted_config_fingerprint = str(
+                binding.get('managed_card_config_fingerprint') or ''
+            ).strip()
+            if (
+                not submitted_config_fingerprint
+                or submitted_config_fingerprint != current_config_fingerprint
+            ):
+                raise ValueError(
+                    "MANAGED_CARD_CONFIG_DRIFTED: API 卡配置在绑定前已变化"
+                )
+            normalized_bindings.append({
+                'card_id': card_id,
+                'spec_name': snapshot[0],
+                'spec_value': snapshot[1],
+                'spec_name_2': snapshot[2],
+                'spec_value_2': snapshot[3],
+                'binding_spec_key': snapshot[4],
+                'managed_card_config_fingerprint': current_config_fingerprint,
+            })
+        return normalized_bindings
+
+    def _assert_existing_binding_set(self, existing: List[tuple], bindings: List[Dict[str, Any]]):
