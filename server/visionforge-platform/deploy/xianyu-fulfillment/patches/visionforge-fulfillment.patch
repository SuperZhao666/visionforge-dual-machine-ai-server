+/**
+ * VisionForge 五套餐运营向导。
+ *
+ * 边界：只编排闲鱼账号、已脱敏 API 卡目录、精确商品规格绑定和规则状态；
+ * 不读取卡券 API 配置，不生成兑换码，不按标题关键字创建规则。
+ * 所有写操作均由服务端重新校验，发布/绑定先落为停用规则，Dry-run 通过后再显式启用。
+ */
+(function () {
+    'use strict';
+
+    const API_BASE = location.origin;
+    const SPEC_NAME = '套餐';
+    const EXPECTED_VARIANT_COUNT = 5;
+    const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
+    const MAX_TOTAL_IMAGE_BYTES = 50 * 1024 * 1024;
+    const MODE = Object.freeze({ NEW: 'new-product', EXISTING: 'bind-existing' });
+    const MANAGED_MODE = Object.freeze({ OFF: 'off', SHADOW: 'shadow', LIVE: 'live' });
+    const CAPABILITY = Object.freeze({
+        SUPPORTED: 'supported',
+        UNSUPPORTED: 'unsupported',
+        UNKNOWN: 'unknown',
+        CHECKING: 'checking'
+    });
+    const ENDPOINT = Object.freeze({
+        ACCOUNTS: '/cookies/details',
+        CATALOG: '/product-publish/visionforge/catalog',
+        CAPABILITY: '/product-publish/capabilities',
+        SYNCED_ITEMS: '/product-publish/visionforge/synced-items',
+        VALIDATE: '/product-publish/visionforge/validate',
+        PUBLISH: '/product-publish/visionforge',
+        VALIDATE_EXISTING: '/product-publish/visionforge/bind-existing/validate',
+        BIND_EXISTING: '/product-publish/visionforge/bind-existing',
+        DRY_RUN: operationId => `/product-publish/visionforge/${encodeURIComponent(operationId)}/binding-dry-run`,
+        ACTIVATE: operationId => `/product-publish/visionforge/${encodeURIComponent(operationId)}/activate`,
+        DEACTIVATE: operationId => `/product-publish/visionforge/${encodeURIComponent(operationId)}/deactivate`
+    });
+
+    let initialized = false;
+    let state = createState();
+
+    function createState() {
+        return {
+            operationMode: MODE.NEW,
+            catalogCards: [],
+            expectedSpecValues: [],
+            defaultInventory: null,
+            inventoryBySpec: new Map(),
+            variantDrafts: new Map(),
+            catalogReady: false,
+            capabilityStatus: CAPABILITY.UNKNOWN,
+            managedMode: MANAGED_MODE.OFF,
+            syncedItems: [],
+            validatedSignature: '',
+            clientRequestId: '',
+            operationId: '',
+            operationVersion: null,
+            busyAction: '',
+            dryRunValid: false,
+            requiresActivation: false,
+            rulesActive: false,
+            activationApiUnavailable: false,
+            deactivationApiUnavailable: false
+        };
+    }
+
+    async function load() {
+        initialize();
+        setItemPublishMode('visionforge');
+        await Promise.all([loadAccounts(), loadCatalog()]);
+    }
+
+    function initialize() {
+        if (initialized) return;
+        const form = document.getElementById('visionForgePublishForm');
+        if (form) {
+            form.addEventListener('input', markPlanDirty);
+            form.addEventListener('change', handleFormChange);
+        }
+        setOperationMode(state.operationMode);
+        renderActionButtons();
+        initialized = true;
+    }
+
+    function setItemPublishMode(mode) {
+        const isWizard = mode !== 'legacy';
+        setDisplay('visionForgePublishPanel', isWizard);
+        setDisplay('legacyItemPublishPanel', !isWizard);
+        setButtonStyle('visionForgePublishModeBtn', isWizard);
+        setButtonStyle('legacyPublishModeBtn', !isWizard);
+    }
+
+    function setOperationMode(mode) {
+        state.operationMode = Object.values(MODE).includes(mode) ? mode : MODE.NEW;
+        const isNew = state.operationMode === MODE.NEW;
+        setButtonStyle('visionForgeNewProductModeBtn', isNew);
+        setButtonStyle('visionForgeExistingProductModeBtn', !isNew);
+        setDisplay('visionForgeExistingItemField', !isNew);
+        document.querySelectorAll('[data-visionforge-new-product-field]').forEach(element => {
+            element.style.display = isNew ? '' : 'none';
+        });
+        setText('visionForgeVariantPriceHeader', isNew ? '闲鱼售价' : '官方商品售价（沿用）');
+        setText('visionForgeVariantInventoryHeader', isNew ? '库存' : '官方库存（沿用）');
+        renderVariantRows();
+        markPlanDirty();
+        renderCapability();
+        renderActionButtons();
+    }
+
+    function handleFormChange(event) {
+        markPlanDirty();
+        if (event.target?.id === 'visionForgePublishCookieId') {
+            loadAccountContext(event.target.value);
+        } else if (event.target?.id === 'visionForgePublishImages') {
+            renderImageSummary();
+        } else if (event.target?.id === 'visionForgeExistingItemId') {
+            renderExistingItemMessage();
+        }
+    }
+
+    async function loadAccounts() {
+        const select = document.getElementById('visionForgePublishCookieId');
+        if (!select) return;
+        const currentValue = select.value;
+        try {
+            const accounts = await requestJson(ENDPOINT.ACCOUNTS);
+            const available = Array.isArray(accounts)
+                ? accounts.filter(account => account.has_cookie_value !== false && account.enabled !== false)
+                : [];
+            populateAccountSelect(select, available, currentValue);
+            if (select.value) await loadAccountContext(select.value);
+        } catch (error) {
+            select.innerHTML = '<option value="">加载账号失败</option>';
+            reportError(error, '加载发布账号失败');
+        }
+    }
+
+    function populateAccountSelect(select, accounts, currentValue) {
+        select.innerHTML = '<option value="">请选择账号</option>';
+        accounts.forEach(account => {
+            const option = document.createElement('option');
+            option.value = account.id;
+            option.textContent = buildAccountLabel(account);
+            select.appendChild(option);
+        });
+        if (currentValue && accounts.some(account => String(account.id) === String(currentValue))) {
+            select.value = currentValue;
+        } else if (accounts.length === 1) {
+            select.value = accounts[0].id;
+        }
+    }
+
+    function buildAccountLabel(account) {
+        const label = String(account.remark || account.username || '').trim();
+        return label ? `${account.id} · ${label}` : String(account.id || '');
+    }
+
+    async function loadAccountContext(accountId) {
+        state.capabilityStatus = CAPABILITY.UNKNOWN;
+        state.syncedItems = [];
+        renderSyncedItems();
+        if (!accountId) {
+            renderCapability();
+            return;
+        }
+        await Promise.all([loadCapability(accountId), loadSyncedItems(accountId)]);
+    }
+
+    async function loadCapability(accountId) {
+        state.capabilityStatus = CAPABILITY.CHECKING;
+        renderCapability('正在向闲鱼检查多规格发布能力…');
+        try {
+            const path = `${ENDPOINT.CAPABILITY}?account_id=${encodeURIComponent(accountId)}`;
+            const data = await requestJson(path);
+            applyManagedModeFromDto(data);
+            state.capabilityStatus = normalizeCapability(data);
+            renderCapability(data.message || '发布能力检查完成。');
+        } catch (error) {
+            state.capabilityStatus = CAPABILITY.UNKNOWN;
+            renderCapability(formatError(error, '能力检查失败，已禁止新发布。'));
+        }
+    }
+
+    function normalizeCapability(data) {
+        const multiSkuSupported = normalizeBooleanFlag(data?.multi_sku_supported);
+        if (multiSkuSupported === true) return CAPABILITY.SUPPORTED;
+        if (multiSkuSupported === false) return CAPABILITY.UNSUPPORTED;
+        const status = String(data?.status || '').trim().toLowerCase();
+        if (['supported', 'yes'].includes(status)) return CAPABILITY.SUPPORTED;
+        if (['unsupported', 'no'].includes(status)) return CAPABILITY.UNSUPPORTED;
+        return Object.values(CAPABILITY).includes(status) ? status : CAPABILITY.UNKNOWN;
+    }
+
+    function normalizeBooleanFlag(value) {
+        if (value === true || value === false) return value;
+        const normalized = String(value ?? '').trim().toLowerCase();
+        if (['true', 'yes', '1'].includes(normalized)) return true;
+        if (['false', 'no', '0'].includes(normalized)) return false;
+        return null;
+    }
+
+    function renderCapability(message = '') {
+        const map = {
+            supported: ['支持多规格', 'text-bg-success'],
+            unsupported: ['不支持新发布', 'text-bg-warning'],
+            checking: ['检查中', 'text-bg-info'],
+            unknown: ['未知 / 已阻断', 'text-bg-secondary']
+        };
+        const [label, cssClass] = map[state.capabilityStatus] || map.unknown;
+        setBadge('visionForgeCapabilityBadge', label, cssClass);
+        setText('visionForgeCapabilityMessage', message || defaultCapabilityMessage());
+        const shouldGuide = state.capabilityStatus === CAPABILITY.UNSUPPORTED;
+        setDisplay('visionForgeUnsupportedGuide', shouldGuide);
+        if (shouldGuide) {
+            setText('visionForgeUnsupportedGuideMessage', '检测结果 capability=no：此账号不能通过 API 新发布多规格商品。请先在闲鱼官方端创建五套餐商品，再回到“商品管理”同步，并使用“绑定已同步官方商品”；非多规格或规格不齐仍会被阻断。');
+        }
+        renderActionButtons();
+    }
+
+    function defaultCapabilityMessage() {
+        if (state.capabilityStatus === CAPABILITY.SUPPORTED) return '账号允许发布多规格商品。';
+        if (state.capabilityStatus === CAPABILITY.UNSUPPORTED) return '账号不能通过 API 新发布，但仍可绑定官方已创建并同步的多规格商品。';
+        if (state.capabilityStatus === CAPABILITY.CHECKING) return '正在检查，请稍候。';
+        return '状态未知时不会允许新发布。';
+    }
+
+    function applyManagedMode(value) {
+        const normalized = String(value || '').trim().toLowerCase();
+        state.managedMode = Object.values(MANAGED_MODE).includes(normalized) ? normalized : MANAGED_MODE.OFF;
+        const map = {
+            off: ['off（已关闭）', 'text-bg-secondary'],
+            shadow: ['shadow（仅演练）', 'text-bg-warning'],
+            live: ['live（可启用）', 'text-bg-success']
+        };
+        const [label, cssClass] = map[state.managedMode];
+        setBadge('visionForgeManagedModeBadge', label, cssClass);
+        renderActionButtons();
+    }
+
+    function applyManagedModeFromDto(data) {
+        const value = data?.managed_fulfillment_mode ?? data?.fulfillment_mode ?? data?.mode;
+        if (value !== undefined && value !== null && String(value).trim()) applyManagedMode(value);
+    }
+
+    async function loadSyncedItems(accountId) {
+        const select = document.getElementById('visionForgeExistingItemId');
+        if (select) select.innerHTML = '<option value="">正在加载已同步商品…</option>';
+        try {
+            const path = `${ENDPOINT.SYNCED_ITEMS}?account_id=${encodeURIComponent(accountId)}`;
+            const data = await requestJson(path);
+            state.syncedItems = Array.isArray(data.items) ? data.items : [];
+            renderSyncedItems();
+        } catch (error) {
+            state.syncedItems = [];
+            renderSyncedItems(formatError(error, '加载已同步商品失败'));
+        }
+    }
+
+    function renderSyncedItems(errorMessage = '') {
+        const select = document.getElementById('visionForgeExistingItemId');
+        if (!select) return;
+        const currentValue = select.value;
+        select.innerHTML = '<option value="">请选择已同步商品</option>';
+        state.syncedItems.forEach(item => appendSyncedItemOption(select, item));
+        if (currentValue && state.syncedItems.some(item => String(item.item_id) === currentValue)) {
+            select.value = currentValue;
+        }
+        if (errorMessage) {
+            select.innerHTML = '';
+            const option = document.createElement('option');
+            option.textContent = errorMessage;
+            select.appendChild(option);
+        }
+        renderExistingItemMessage();
+    }
+
+    function appendSyncedItemOption(select, item) {
+        const option = document.createElement('option');
+        option.value = item.item_id;
+        const label = item.is_service_option_item ? '服务选项' : item.is_multi_spec ? '多规格' : '非多规格';
+        option.textContent = `${label} · ${item.title || item.item_title || item.item_id}`;
+        option.disabled = !canBindSyncedItem(item);
+        select.appendChild(option);
+    }
+
+    function canBindSyncedItem(item) {
+        return item?.is_multi_spec === true || item?.is_service_option_item === true;
+    }
+
+    function getSelectedSyncedItem() {
+        const itemId = document.getElementById('visionForgeExistingItemId')?.value || '';
+        return state.syncedItems.find(item => String(item.item_id) === String(itemId)) || null;
+    }
+
+    function renderExistingItemMessage() {
+        const item = getSelectedSyncedItem();
+        const message = document.getElementById('visionForgeExistingItemMessage');
+        if (!item) {
+            setText('visionForgeExistingItemMessage', '只允许按账号 + item_id + 规格精确绑定；普通多规格或闲鱼 App 服务选项商品可选择。');
+            if (message) message.className = 'form-text';
+            return;
+        }
+        const status = getSpecValuesStatus(item);
+        if (status === 'service_option') {
+            const specs = Array.isArray(item.spec_values) ? item.spec_values.join('、') : '无';
+            setText('visionForgeExistingItemMessage', `item_id ${item.item_id} · 闲鱼服务选项商品：按订单规格和价格二次校验后发货 · 规格：${specs}`);
+            if (message) message.className = 'form-text text-info';
+            return;
+        }
+        if (status === 'unknown') {
+            setText('visionForgeExistingItemMessage', `item_id ${item.item_id} · 规格值读取状态 unknown：可创建停用规则，但必须经服务端校验和 Dry-run 后才能启用。`);
+            if (message) message.className = 'form-text text-warning';
+            return;
